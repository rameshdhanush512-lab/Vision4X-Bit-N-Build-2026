# ============================================================
# PRIVEX Server — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env to git.
# ============================================================

# ── Server
PORT=3001
NODE_ENV=development

# ── Database
# Option A: SQLite (local dev/demo — no setup needed)
DATABASE_URL="file:../prisma/dev.db"

# Option B: PostgreSQL / Supabase (production)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# ── JWT
JWT_SECRET=replace_with_a_long_random_secret_string_min_32_chars
JWT_EXPIRES_IN=7d

# ── Ollama (local LLM — optional, falls back to template if unavailable)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Frontend origin (for CORS)
CLIENT_ORIGIN=http://localhost:5173
# Production: CLIENT_ORIGIN=https://your-vercel-app.vercel.app
