// PRIVEX — Prisma Schema
// SQLite (local dev/demo) — enums stored as String

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  exposures        Exposure[]
  privacyRequests  PrivacyRequest[]
  agentRuns        AgentRun[]
  followUps        FollowUp[]

  @@map("users")
}

// ─────────────────────────────────────────────
// EXPOSURE
// ExposureStatus: DETECTED | ANALYZING | ACTION_REQUIRED | REQUEST_SENT | FOLLOW_UP_REQUIRED | RESOLVED | FALSE_POSITIVE
// ─────────────────────────────────────────────
model Exposure {
  id                String   @id @default(uuid())
  userId            String
  source            String
  dataTypes         String   // JSON-encoded string array e.g. '["email","phone"]'
  severityCandidate String
  confidence        Float
  evidence          String
  rawData           String?  // JSON string (full scout output)
  status            String   @default("DETECTED")
  detectedAt        DateTime @default(now())
  resolvedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  riskAssessment      RiskAssessment?
  privacyRequests     PrivacyRequest[]
  verificationResults VerificationResult[]

  @@map("exposures")
}

// ─────────────────────────────────────────────
// RISK ASSESSMENT
// RiskLevel: LOW | MEDIUM | HIGH | CRITICAL
// ─────────────────────────────────────────────
model RiskAssessment {
  id             String   @id @default(uuid())
  exposureId     String   @unique
  riskLevel      String
  riskScore      Int
  explanation    String
  factors        String   // JSON-encoded string array
  recommendation String
  analyzedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  exposure Exposure @relation(fields: [exposureId], references: [id], onDelete: Cascade)

  @@map("risk_assessments")
}

// ─────────────────────────────────────────────
// AGENT RUN
// AgentStatus: WAITING | RUNNING | COMPLETED | FAILED | SKIPPED
// ─────────────────────────────────────────────
model AgentRun {
  id          String    @id @default(uuid())
  userId      String
  scanId      String
  agentName   String
  task        String
  status      String    @default("WAITING")
  result      String?
  metadata    String?   // JSON string
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("agent_runs")
}

// ─────────────────────────────────────────────
// PRIVACY REQUEST
// RequestType:   DATA_DELETION | DATA_CORRECTION | OPT_OUT | RIGHT_TO_ERASURE | ACCESS_REQUEST
// RequestStatus: DRAFT | READY | SENT | ACKNOWLEDGED | PROCESSING | VERIFIED | COMPLETED | REJECTED | EXPIRED | FAILED
// ─────────────────────────────────────────────
model PrivacyRequest {
  id               String    @id @default(uuid())
  userId           String
  exposureId       String
  targetOrg        String
  requestType      String
  reason           String
  generatedRequest String
  status           String    @default("DRAFT")
  sentAt           DateTime?
  followUpDate     DateTime?
  emailLog         String?   // JSON string
  activityLog      String?   // JSON string
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  exposure  Exposure   @relation(fields: [exposureId], references: [id], onDelete: Cascade)
  followUps FollowUp[]

  @@map("privacy_requests")
}

// ─────────────────────────────────────────────
// FOLLOW UP
// FollowUpStatus: PENDING | DUE | COMPLETED | SKIPPED
// ─────────────────────────────────────────────
model FollowUp {
  id               String    @id @default(uuid())
  userId           String
  privacyRequestId String
  scheduledAt      DateTime
  status           String    @default("PENDING")
  notes            String?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  privacyRequest PrivacyRequest @relation(fields: [privacyRequestId], references: [id], onDelete: Cascade)

  @@map("follow_ups")
}

// ─────────────────────────────────────────────
// VERIFICATION RESULT
// VerificationOutcome: STILL_EXPOSED | RESOLVED | PARTIAL | UNABLE_TO_VERIFY
// ─────────────────────────────────────────────
model VerificationResult {
  id         String   @id @default(uuid())
  exposureId String
  method     String
  outcome    String
  notes      String?
  verifiedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  exposure Exposure @relation(fields: [exposureId], references: [id], onDelete: Cascade)

  @@map("verification_results")
}
